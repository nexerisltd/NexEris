# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — full database access. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public address of the deployed site (used for metadata and the API docs).
NEXT_PUBLIC_SITE_URL=https://nexeris.vercel.app
